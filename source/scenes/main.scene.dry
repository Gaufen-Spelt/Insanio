title: Next month
set-bg: img/map_2.jpg
is-hand: true
on-arrival: {!
Q.pinnedCardsDescription = '';
Q.deckDescription = '';
Q.handDescription = '';
!}

- @maps
- @letter

{!<style>
  body {
    background: #111;
    color: #ddd;
    font-family: Georgia, serif;
    max-width: 600px;
    margin: 40px auto;
    padding: 0 20px;
  }
  h1 { margin-bottom: 12px; margin-top: 20px; }
  .note-wrap { margin: 16px 0; }
  .note-area {
    width: 100%;
    min-height: 180px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.15);
    border-left: 4px solid rgba(255,255,255,0.3);
    color: inherit;
    font-family: inherit;
    font-size: 0.9em;
    line-height: 1.6;
    padding: 10px 12px;
    resize: vertical;
    box-sizing: border-box;
    outline: none;
    transition: border-color 0.2s;
  }
  .note-area:focus {
    border-color: rgba(255,255,255,0.5);
    border-left-color: rgba(255,255,255,0.7);
    background: rgba(255,255,255,0.06);
  }
  .note-area::placeholder {
    color: rgba(255,255,255,0.25);
    font-style: italic;
  }
  .note-hint {
    font-size: 0.72em;
    color: rgba(255,255,255,0.25);
    margin-top: 4px;
    text-align: right;
  }
</style>
</head>
<body>

<h1>Notes</h1>

<div class="note-wrap">
  <textarea class="note-area" id="player-notes" placeholder="Write anything..."></textarea>
  <div class="note-hint">saved automatically</div>
</div>

<script>
(function() {
  var KEY = 'player_notes';
  var ta = document.getElementById('player-notes');
  if (!ta) return;
  var saved = localStorage.getItem(KEY);
  if (saved) ta.value = saved;
  ta.addEventListener('input', function() {
    localStorage.setItem(KEY, ta.value);
  });
})();
</script>!}
