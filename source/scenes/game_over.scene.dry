title: Game Over.
new-page: true
go-to: eg_menu
on-arrival: {!
Q.game_over = 1;

// Eiserne Front - Form the Iron Front.
this.achieve('game_completed');

!}

= End


@eg_menu

- @end_game: End game.
- @achievements

@achievements
title: Achievements
view-if: achievement_game_completed == 1
tags: endings
go-to: eg_menu if started == 1; root.start_menu_2 if started == 0

{!<style>
.ach-locked { border-color: #999 !important; background-color: rgba(150,150,150,0.1) !important; color: #999; }
.ach-locked .ach-icon { background-color: #999 !important; }
.ach-new { font-size: 0.72em; background: #E3000F; color: white; padding: 1px 6px; border-radius: 3px; margin-left: 8px; vertical-align: middle; }
.ach-mod { padding-left: 24px; }
h1, h2, h3 { margin-bottom: 12px; margin-top: 20px; }
.ach-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px;
  margin-bottom: 16px;
  align-items: start;
}

.ach {
  display: flex;
  align-items: flex-start;
  padding: 8px;
  margin: 0;
  border-left: 4px solid;
  height: auto;
  word-break: break-word;
  overflow-wrap: break-word;
  min-width: 0;
}

.ach-icon {
  display: inline-block;
  width: 12px;
  height: 12px;
  margin-right: 8px;
  flex-shrink: 0;
  margin-top: 3px;
}

.ach-cybersyn {
    border-left: 6px solid #00FF41;
    background: #0a0a0a;
    font-family: 'Courier New', Courier, monospace;
    text-transform: uppercase;
    color: #00FF41;
    text-shadow: 0 0 8px #00FF41, 0 0 2px #00FF41;
    box-shadow: inset 0 0 20px rgba(0, 255, 65, 0.08), 0 0 4px rgba(0,255,65,0.2);
    letter-spacing: 1px;
    font-size: 0.82em;
    position: relative;
    overflow: hidden;
}
.ach-cybersyn::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: repeating-linear-gradient(
        0deg,
        transparent,
        transparent 2px,
        rgba(0, 0, 0, 0.15) 2px,
        rgba(0, 0, 0, 0.15) 4px
    );
    pointer-events: none;
}
.ach-cybersyn .ach-icon {
    background: #00FF41 !important;
    box-shadow: 0 0 6px #00FF41;
    animation: blink 1.2s step-end infinite;
}
.ach-cybersyn.ach-locked {
    color: #1a3a1a;
    text-shadow: none;
    border-color: #1a3a1a;
    box-shadow: none;
}
.ach-cybersyn.ach-locked .ach-icon {
    background: #1a3a1a !important;
    box-shadow: none;
    animation: none;
}

</style>!}

= Achievements

{!<div class="ach-section">!}

[? if achievement_doorkey :
{!<div class="ach" style="border-color:#f5a623; background:rgba(245,166,35,0.15)"><span class="ach-icon" style="background:#f5a623"></span><strong>First Key</strong> - Open the keydoor.!}[? if game_achievement_doorkey : {!<span class="ach-new">New!</span>!}?]{!</div>!}
?]
[? if not achievement_doorkey :
{!<div class="ach ach-locked"><span class="ach-icon"></span><strong>First Key</strong> - Open the keydoor.</div>!}
?]

[? if achievement_colorkey :
{!<div class="ach" style="border-color:rgba(80,180,160,0.9); background:rgba(80,180,160,0.12)"><span class="ach-icon" style="background:rgba(80,180,160,0.85)"></span><strong>Colors & Shades</strong> - And their meanings.!}[? if game_achievement_colorkey : {!<span class="ach-new">New!</span>!}?]{!</div>!}
?]
[? if not achievement_colorkey :
{!<div class="ach ach-locked"><span class="ach-icon"></span><strong>Colors & Shades</strong> - And their meanings.</div>!}
?]

[? if achievement_vent :
{!<div class="ach" style="border-color:#9b59b6; background:rgba(155,89,182,0.15)"><span class="ach-icon" style="background:#9b59b6"></span><strong>Vent</strong> - Pathway.!}[? if game_achievement_vent : {!<span class="ach-new">New!</span>!}?]{!</div>!}
?]
[? if not achievement_vent :
{!<div class="ach ach-locked"><span class="ach-icon"></span><strong>Vent</strong> - Pathway.</div>!}
?]

{!</div>!}

= Endings

{!<div class="ach-section">!}

[? if achievement_ending :
{!<div class="ach" style="border-color:#9b59b6; background:rgba(155,89,182,0.15)"><span class="ach-icon" style="background:#9b59b6"></span><strong>Inevitable</strong> - Learn the truth.!}[? if game_achievement_ending : {!<span class="ach-new">New!</span>!}?]{!</div>!}
?]
[? if not achievement_ending :
{!<div class="ach ach-locked"><span class="ach-icon"></span><strong>Inevitable</strong> - Learn the truth.</div>!}
?]

[? if achievement_indeemable :
{!<div class="ach" style="border-color:#9b59b6; background:rgba(155,89,182,0.15)"><span class="ach-icon" style="background:#9b59b6"></span><strong>Indeemable</strong> - For how all this is wasteland.!}[? if game_achievement_indeemable : {!<span class="ach-new">New!</span>!}?]{!</div>!}
?]
[? if not achievement_indeemable :
{!<div class="ach ach-locked"><span class="ach-icon"></span><strong>Indeemable</strong> - For how all this is wasteland.</div>!}
?]

[? if achievement_sacrificial :
{!<div class="ach" style="border-color:#9b59b6; background:rgba(155,89,182,0.15)"><span class="ach-icon" style="background:#9b59b6"></span><strong>Last Stand</strong> - Bring the end to inevitable.!}[? if game_achievement_sacrificial : {!<span class="ach-new">New!</span>!}?]{!</div>!}
?]
[? if not achievement_sacrificial :
{!<div class="ach ach-locked"><span class="ach-icon"></span><strong>Last Stand</strong> - Bring the end to inevitable.</div>!}
?]

{!</div>!}

{!<script>
(function() {
  function reflow() {
    document.querySelectorAll('.ach-section').forEach(function(section) {
      var items = Array.from(section.querySelectorAll('.ach'));
      if (items.length === 0) return;
      var grid = document.createElement('div');
      grid.className = 'ach-grid';
      items.forEach(function(el) {
        el.parentNode.removeChild(el);
        grid.appendChild(el);
      });
      section.appendChild(grid);
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', reflow);
  } else {
    reflow();
  }
})();
</script>!}

@end_game
game-over: true
