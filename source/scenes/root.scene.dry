@start
on-arrival: {!
function generateCode() {
    var digit1 = Math.floor(Math.random() * 10);
    var digit2 = Math.floor(Math.random() * 10);
    var digit3 = Math.floor(Math.random() * 10);
    var digit4 = Math.floor(Math.random() * 10);

    return digit1 + "" + digit2 + "" + digit3 + "" + digit4;
}

var code = generateCode();
console.log(code); // e.g. "4827"
Q.secret_code = code;

Q.started = 1;
// time elapsed (in months)
Q.time = 1;
Q.year = 1928;
Q.month = 1;
// how many actions have been taken this month?
Q.month_actions = 0;

// 0 = normal difficulty, 1 = hard mode, 2 = hard mode no saves
Q.difficulty = 0;
Q.historical_mode = 0;
// old demographics
Q.old_demographics = 0;
// use decimals for reichstag seats
// TODO: not yet implemented
Q.use_decimals = 0;

Q.timers = ['advisor_action', 'confronting_nazis', 'crisis_program',
            'fundraising', 'ideology',
            'inter_party_relationships', 'international_relations',
            'iron_front', 'media', 'enemies',
            'party_organizations', 'rally', 'reichsbanner',
            'shuffle_leadership', 'streetfighting', 'peoples_party',
            'party_disunity',
            // govt
            'agricultural_policy', 'domestic_enemies', 'fiscal_policy',
            'foreign_policy', 'judiciary', 'labor_affairs', 'military_policy',
            'police', 'prussian_affairs', 'shuffle_cabinet', 'social_welfare',
            'homosexual_rights', 'economic_policy', 'coalition_affairs',
            'war_guilt', 'womens_rights', 'economic_democracy',
            'dealing_with_toleration',
            'constitutional_reform', 'labor_rights',
            'education_science', 'curriculum',
            // events
            'emergency_cuts', 'unemployment_insurance',
            'sa_ban', 'sh_ban', 'papen_chancellor',
            'kpd_policy', 'kpd_ultimatum', 'popular_front_dispute',
            'high_inflation', 'banking_crisis', 'march_on_berlin',
            'understanding_enemy', 'schleichers_schemes'];
!}
new-page: true

- @intro: Begin my ways...

@intro
subtitle: And your soul...
set-bg: images/insignia.png
on-arrival: {!

var overlay = document.createElement('div');
overlay.id = 'game-intro-overlay';
overlay.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;background:#000;z-index:9999;display:flex;flex-direction:column;align-items:center;justify-content:center;pointer-events:none;';
document.body.appendChild(overlay);

function addLine(text, delay, style) {
    setTimeout(function() {
        var el = document.createElement('div');
        el.style.cssText = 'color:#d4c89a;font-family:"Minion Pro",Georgia,serif;opacity:0;transition:opacity 1s ease;' + (style || '');
        el.textContent = text;
        overlay.appendChild(el);
        setTimeout(function() { el.style.opacity = '1'; }, 50);
    }, delay);
}

addLine('....', 400, 'font-size:3em;letter-spacing:0.2em;margin-bottom:0.5em;');
addLine('...,', 1800, 'font-size:1.4em;letter-spacing:0.1em;');
addLine('Status established: Heartbeat is stable.', 2800, 'font-size:1.4em;letter-spacing:0.1em;margin-top:0.3em;');

setTimeout(function() {
    overlay.style.transition = 'opacity 2.5s ease';
    overlay.style.opacity = '0';
    setTimeout(function() {
        if (overlay.parentNode) overlay.parentNode.removeChild(overlay);
    }, 2000);
}, 4500);
!}

