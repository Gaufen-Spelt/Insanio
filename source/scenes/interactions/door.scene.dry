title: The Door
subtitle: It has some sort of encryption...
tags: inter
new-page: true
go-to: door_open if door_open = 1

= Door

- @open: Enter the code
- @interactions: Back to interactions

@open
new-page: true
on-display: {!
    var container = document.getElementById('door-input');
    container.innerHTML = '';

    var digits = ['', '', '', ''];
    var wrapper = document.createElement('div');
    wrapper.style.cssText = 'display:flex; gap:0.5em; align-items:center; margin:0.5em 0;';

    for (var i = 0; i < 4; i++) {
        (function(index) {
            var input = document.createElement('input');
            input.type = 'text';
            input.maxLength = 1;
            input.style.cssText =
                'width:2em; height:2em; text-align:center; font-size:1.2em;' +
                'font-family:monospace; border:1px solid #876;' +
                'background:var(--content-bg-color); color:var(--text-color); outline:none;';
            input.addEventListener('input', function() {
                digits[index] = this.value.replace(/[^0-9]/g, '');
                this.value = digits[index];
                if (digits[index] && index < 3) {
                    wrapper.querySelectorAll('input')[index + 1].focus();
                }
            });
            input.addEventListener('keydown', function(e) {
                if (e.key === 'Enter') btn.click();
            });
            wrapper.appendChild(input);
        })(i);
    }

    var btn = document.createElement('button');
    btn.textContent = 'Confirm';
    btn.style.cssText =
        'font-family:inherit; background:none; border:1px solid #876;' +
        'color:var(--text-color); padding:0.3em 0.8em; cursor:pointer; margin-left:0.5em;';

    var msg = document.createElement('p');
    msg.style.cssText = 'color:#f55; font-size:12px; margin-top:6px; height:16px;';

    btn.addEventListener('click', function() {
        var entered = digits.join('');
        var secret = window.dendryUI.dendryEngine.state.qualities.secret_code;
        if (entered === String(secret)) {
            window.dendryUI.dendryEngine.state.qualities.door_open = 1;
            window.dendryUI.dendryEngine.goToScene('door.door_result');
        } else {
            msg.textContent = '✗ Wrong code.';
            digits = ['', '', '', ''];
            wrapper.querySelectorAll('input').forEach(function(el) { el.value = ''; });
            wrapper.querySelectorAll('input')[0].focus();
        }
    });

    wrapper.appendChild(btn);
    container.appendChild(wrapper);
    container.appendChild(msg);
    wrapper.querySelectorAll('input')[0].focus();
!}

= Enter the code.

{!<div id="door-input"></div>!}

- @door_result: And...
- @door: Back

@door_result
go-to: open if door_open = 0; door_open if door_open = 1

@door_open
achievement: doorkey

